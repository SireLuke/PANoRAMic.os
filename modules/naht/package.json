{
  "name": "@panoramic/naht",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone, modular Non-Abelian History Transport core",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./backends/quaternion": {
      "types": "./dist/backends/quaternion.d.ts",
      "import": "./dist/backends/quaternion.js"
    },
    "./topology/graph": {
      "types": "./dist/topology/graph.d.ts",
      "import": "./dist/topology/graph.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
