{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "api/**/*",
    "core/**/*",
    "engine/**/*",
    "rams/**/*",
    "cli/**/*",
    "src/**/*",
    "dashboard/**/*"
  ]
}
